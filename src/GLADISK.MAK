ROM=GLADISK
ASM=MASM /L /Zd
LNK=LINK /MAP /LI /PACKCODE
OPT2ROM=.\OPT2ROM\OPT2ROM4
BUILD_DIR=.\BUILD
DEPS=GLADISK.INC GLADISK.MAK GLALIB.INC SEGS.INC EQU.INC FDC.INC MACROS.INC INT_13.INC CMOS.INC

$(ROM).OBJ: $*.ASM $(DEPS)
	$(ASM) $*;

C_A.OBJ: CMOS_AT.ASM $(DEPS)
	$(ASM) CMOS_AT.ASM,$*;

C_L.OBJ: CMOS_LSI.ASM $(DEPS)
	$(ASM) CMOS_LSI.ASM,$*;

C_D.OBJ: CMOS_DTK.ASM $(DEPS)
	$(ASM) CMOS_DTK.ASM,$*;

C_N.OBJ: CMOS_NS.ASM $(DEPS)
	$(ASM) CMOS_NS.ASM,$*;

C_AC.OBJ: CMOS_ACC.ASM $(DEPS)
	$(ASM) CMOS_ACC.ASM,$*;

C_C.OBJ: CMOS_CA.ASM $(DEPS)
	$(ASM) CMOS_CA.ASM,$*;

C_G.OBJ: CMOS_GEN.ASM $(DEPS)
	$(ASM) CMOS_GEN.ASM,$*;

GL.OBJ: GLALIB.ASM $(DEPS)
	$(ASM) GLALIB.ASM,$*;

I13.OBJ: INT_13.ASM $(DEPS)
	$(ASM) INT_13.ASM,$*;

I13H.OBJ: INT_13_H.ASM $(DEPS)
	$(ASM) INT_13_H.ASM,$*;

$(ROM).EXE: $*.OBJ C_A.OBJ C_L.OBJ C_D.OBJ C_N.OBJ C_AC.OBJ C_C.OBJ I13.OBJ I13H.OBJ GL.OBJ
	$(LNK) $**,$*,$*;
	$(OPT2ROM) $@ $*.ROM
	COPY $*.ROM $(BUILD_DIR)\

